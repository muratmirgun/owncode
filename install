#!/usr/bin/env bash
set -euo pipefail

# Download one release, verify its checksum, then replace the binary atomically.
version=${VERSION:-}
install_dir=${OWNCODE_INSTALL_DIR:-"$HOME/.owncode/bin"}
while (($#)); do
  case "$1" in
    --version|--install-dir)
      [[ $# -ge 2 && -n "$2" ]] || { echo "Missing value for $1" >&2; exit 1; }
      if [[ $1 == --version ]]; then version=$2; else install_dir=$2; fi
      shift 2 ;;
    --help|-h)
      echo 'Usage: bash install [--version v0.1.0] [--install-dir PATH]'
      exit 0 ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done
for dependency in curl tar install; do
  command -v "$dependency" >/dev/null || { echo "Required command not found: $dependency" >&2; exit 1; }
done
case $(uname -s) in
  Darwin) platform=mac ;;
  Linux) platform=linux ;;
  *) echo 'OwnCode supports macOS and Linux.' >&2; exit 1 ;;
esac
case $(uname -m) in
  x86_64|amd64) arch=x86_64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) echo 'OwnCode supports x86_64 and arm64.' >&2; exit 1 ;;
esac
if command -v sha256sum >/dev/null; then
  checksum() { sha256sum "$1" | awk '{print $1}'; }
elif command -v shasum >/dev/null; then
  checksum() { shasum -a 256 "$1" | awk '{print $1}'; }
else
  echo 'Install sha256sum or shasum before running this installer.' >&2
  exit 1
fi
fetch() { curl --fail --silent --show-error --location --retry 3 --connect-timeout 15 --max-time 300 "$@"; }
if [[ -z $version ]]; then
  metadata=$(fetch https://api.github.com/repos/muratmirgun/owncode/releases/latest)
  version=$(printf '%s\n' "$metadata" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
fi
version=${version#v}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo 'No valid release version found.' >&2; exit 1; }
archive="owncode-$platform-$arch.tar.gz"
base="https://github.com/muratmirgun/owncode/releases/download/v$version"
tmp_dir=$(mktemp -d)
staged=''
cleanup() {
  rm -rf "$tmp_dir"
  if [[ -n $staged ]]; then rm -f "$staged"; fi
}
trap cleanup EXIT
printf 'Downloading OwnCode %s for %s/%s…\n' "$version" "$platform" "$arch"
fetch "$base/$archive" -o "$tmp_dir/$archive"
fetch "$base/checksums.txt" -o "$tmp_dir/checksums.txt"
expected=$(awk -v file="$archive" '$2 == file {print $1}' "$tmp_dir/checksums.txt")
[[ $expected =~ ^[0-9a-fA-F]{64}$ ]] || { echo 'Release checksum is missing or invalid.' >&2; exit 1; }
actual=$(checksum "$tmp_dir/$archive")
[[ $actual == "$expected" ]] || { echo 'Checksum mismatch. Installation stopped.' >&2; exit 1; }
tar -xzf "$tmp_dir/$archive" -C "$tmp_dir" owncode
[[ -f $tmp_dir/owncode && ! -L $tmp_dir/owncode ]] || { echo 'Release binary is invalid.' >&2; exit 1; }
mkdir -p "$install_dir"
staged=$(mktemp "$install_dir/.owncode-install.XXXXXX")
install -m 755 "$tmp_dir/owncode" "$staged"
mv -f "$staged" "$install_dir/owncode"
staged=''
printf 'Installed OwnCode %s at %s/owncode\n' "$version" "$install_dir"
case ":$PATH:" in
  *":$install_dir:"*) ;;
  *)
    printf 'Add this directory to your shell PATH:\n  export PATH=%q:"$PATH"\n' "$install_dir"
    ;;
esac
