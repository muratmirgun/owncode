#!/usr/bin/env bash
set -euo pipefail
version=${1:-}
dry_run=${2:-}
if [[ ! $version =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ || ( -n $dry_run && $dry_run != --dry-run ) || $# -gt 2 ]]; then
  echo 'Usage: scripts/release v0.1.0 [--dry-run]' >&2
  exit 1
fi
[[ $(git branch --show-current) == main ]] || { echo 'Release from main.' >&2; exit 1; }
[[ -z $(git status --porcelain) ]] || { echo 'Commit all changes before releasing.' >&2; exit 1; }
[[ -z $(git ls-remote --tags origin "refs/tags/$version") ]] || { echo "Tag already exists: $version" >&2; exit 1; }
if git rev-parse --verify "refs/tags/$version" >/dev/null 2>&1; then
  echo "Local tag already exists: $version" >&2
  exit 1
fi
remote_main=$(git ls-remote origin refs/heads/main | awk '{print $1}')
[[ $(git rev-parse HEAD) == "$remote_main" ]] || { echo 'Push main and synchronize it before releasing.' >&2; exit 1; }
if [[ $dry_run == --dry-run ]]; then
  echo "Ready to publish $version from $(git rev-parse --short HEAD)."
  exit 0
fi
git tag -a "$version" -m "OwnCode $version"
git push origin "refs/tags/$version"
echo "Release workflow started for $version."
